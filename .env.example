# Copy to .env (never committed) and set real values.
# OPENAI_API_KEY - required for the LLM (byllm, gpt-4o-mini)
OPENAI_API_KEY=
# PESA_WEBHOOK_SECRET - the webhook secret the forwarder uses on IngestMessage
PESA_WEBHOOK_SECRET=
# PESA_ADMIN_SECRET - the admin secret for the Seed and Reset walkers
PESA_ADMIN_SECRET=
# PESA_HMAC_SECRET - server-side key for redaction HMACs (sender/entity keys).
# Changing it re-keys every sender, so set it once per deployment.
PESA_HMAC_SECRET=
# PESA_INGEST_RATE_MAX - optional, IngestMessage calls allowed per 60s (default 30)
PESA_INGEST_RATE_MAX=
